rules_version = '2';

// ============================================================
// fina - Firestore Security Rules
// Personal one-user app: ownership by path users/{uid}/...
// Data types are checked at the DB layer - never trust the client.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Money is always integer VND. Floats are blocked right here, because
    // summing many floats drifts and can never be fixed (rule #2).
    function isVnd(v) {
      return v is int && v >= 0;
    }

    // Goal: a fund saved up for one big purchase (PLAN-goals.md). Target
    // and month may be unknown (null).
    function validGoal(g) {
      return g is map
        && g.keys().hasOnly(['targetVnd', 'targetMonth', 'status'])
        && (!('targetVnd' in g.keys()) || g.targetVnd == null || (isVnd(g.targetVnd) && g.targetVnd > 0))
        && (!('targetMonth' in g.keys()) || g.targetMonth == null
            || (g.targetMonth is string && g.targetMonth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')))
        && g.status in ['saving', 'later', 'done'];
    }

    function validBucket(d) {
      return d.keys().hasAll(['name', 'kind', 'bank', 'standardVnd', 'order', 'active'])
        && d.name is string
        && d.kind in ['budget', 'fund']
        && d.bank in ['VCB', 'BIDV', 'VPS']
        // Block floats at the DB layer: one float multiplication
        // (4.1 * 1_000_000) once broke the whole seed batch.
        && isVnd(d.standardVnd)
        // Must match HINT_MAX_LENGTH in lib/bucket-hint.ts.
        && (!('hint' in d.keys()) || d.hint == null || (d.hint is string && d.hint.size() <= 200))
        && d.order is int
        && d.active is bool
        // balanceVnd only exists on funds, and can go negative on overspend
        && (!('balanceVnd' in d.keys()) || d.balanceVnd is int)
        // Only funds can be goals.
        && (!('goal' in d.keys()) || d.goal == null || (d.kind == 'fund' && validGoal(d.goal)));
    }

    function validTransaction(d) {
      return d.keys().hasAll(['occurredAt', 'cycle', 'bucketId', 'bank', 'amountVnd', 'source'])
        && d.occurredAt is int
        && d.cycle is string
        && d.cycle.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && d.bucketId is string
        && d.bank in ['VCB', 'BIDV', 'VPS']
        && isVnd(d.amountVnd) && d.amountVnd > 0
        // amountVnd is always positive; direction lives in `direction`, not the sign.
        && (!('direction' in d.keys()) || d.direction in ['out', 'in'])
        && (d.note == null || d.note is string)
        && d.source in ['web', 'import', 'allocation', 'opening', 'move']
        // A move is two entries that share one moveId.
        && (d.source != 'move' || ('moveId' in d.keys() && d.moveId is string))
        && (!('moveId' in d.keys()) || d.moveId is string)
        // Dedup keys from a MoMo screenshot import - plain strings, no names.
        && (!('importKeys' in d.keys()) || (d.importKeys is list && d.importKeys.size() <= 200));
    }

    function validCover(d) {
      return d.keys().hasAll(['txId', 'cycle', 'toBucketId', 'fromBucketId', 'amountVnd', 'needsTransfer', 'status'])
        && d.txId is string
        && d.toBucketId is string
        && d.fromBucketId is string
        && isVnd(d.amountVnd) && d.amountVnd > 0
        && d.needsTransfer is bool
        && d.status in ['pending', 'done'];
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /buckets/{bucketId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validBucket(request.resource.data);
        // Dropping a bucket = active:false, never delete. History must stay (rule #8).
        allow delete: if false;
      }

      match /transactions/{txId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTransaction(request.resource.data);
      }

      // cycles/{cycleId} - e.g. "2026-09"
      match /cycles/{cycleId} {
        allow read, create: if isOwner(uid);
        // A closed cycle can no longer be edited - otherwise past numbers
        // would change every time Settings is adjusted.
        allow update: if isOwner(uid) && resource.data.status != 'closed';
        allow delete: if false;
      }

      match /covers/{coverId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCover(request.resource.data);
      }

      // meta/settings, meta/fcm
      match /meta/{docId} {
        allow read, write: if isOwner(uid);
      }

      // salary/{monthId} - salary entered by hand, one record per CALENDAR MONTH.
      //
      // The password screen is on the CLIENT, so it protects nothing here:
      // the account owner can still read it. Rules only do the rules' job -
      // block other people and block junk data.
      match /salary/{monthId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && monthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && request.resource.data.keys().hasOnly(['amountVnd', 'note', 'updatedAt'])
          && isVnd(request.resource.data.amountVnd)
          && request.resource.data.amountVnd > 0
          && (request.resource.data.note == null || request.resource.data.note is string)
          && request.resource.data.updatedAt is int;
      }

      // insights/{cycleId} - generated AI notes, cached by digestHash
      match /insights/{insightId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Everything else: denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
